#### Technical Notes
**Don't** create 1000 AnimatedElement instances for particles (too expensive).

**Do** create a ParticleSystem class that manages particles as data:
```typescript
class ParticleSystem extends AnimatedElement {
  private particles: Particle[] = [];
  private canvas: HTMLCanvasElement;
  private ctx: CanvasRenderingContext2D;

  constructor(canvas: HTMLCanvasElement, particleCount: number) {
    super();
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d')!;

    // Create particles as plain data
    for (let i = 0; i < particleCount; i++) {
      this.particles.push({
        x: 0, y: 0, targetX: 0, targetY: 0, opacity: 0, size: 2
      });
    }
  }

  update(t: number): void {
    // Update all particles in batch
    for (const particle of this.particles) {
      // Apply track values to particle data
    }
  }

  render(): void {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    for (const particle of this.particles) {
      this.ctx.globalAlpha = particle.opacity;
      this.ctx.beginPath();
      this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
      this.ctx.fill();
    }
  }
}
```

