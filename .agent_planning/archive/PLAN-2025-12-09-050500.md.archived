#### Technical Notes
Create `gallery/src/core/__tests__/Track.perf.test.ts`:

```typescript
import { describe, test, expect } from 'vitest';

describe('Track Performance', () => {
  test('getValue() completes in < 0.01ms for single track', () => {
    const track = new Track({ from: 0, to: 100, duration: 1000 });

    const iterations = 10000;
    const start = performance.now();
    for (let i = 0; i < iterations; i++) {
      track.getValue(500);
    }
    const elapsed = performance.now() - start;

    const avgTime = elapsed / iterations;
    expect(avgTime).toBeLessThan(0.01); // < 0.01ms per call
  });
});
```

Run separately from unit tests: `pnpm test:perf`

