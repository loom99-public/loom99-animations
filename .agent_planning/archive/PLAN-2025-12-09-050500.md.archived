#### Technical Notes
Create `gallery/src/compositors/Compositor.ts`:

```typescript
export abstract class Compositor<T = any> {
  /**
   * Update compositor state based on progress (0-1)
   * Returns value to apply to DOM/Canvas
   */
  abstract update(progress: number): T;

  /**
   * Export compositor logic as SMIL animation
   * Returns SMIL element string or empty if not exportable
   */
  abstract toSMIL(): string;

  /**
   * Reset compositor to initial state
   */
  reset?(): void;
}

export class PathMorphCompositor extends Compositor<string> {
  update(progress: number): string {
    // Returns path 'd' string
  }

  toSMIL(): string {
    // Returns <animate attributeName="d" ...>
  }
}
```

Future compositors:
- TransformCompositor: combines translate/rotate/scale → CSS transform string
- ParticleCompositor: manages particle positions → particle array
- ColorCompositor: interpolates color values → CSS color string

