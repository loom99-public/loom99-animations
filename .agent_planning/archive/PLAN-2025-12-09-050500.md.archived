class LineElement extends BaseElement {
  private animationType?: 'pathMorph' | 'lineDrawing';

  addPathMorph(...) {
    if (this.animationType) throw new Error('Animation already configured');
    this.animationType = 'pathMorph';
    // ...
  }

  addLineDrawing(...) {
    if (this.animationType) throw new Error('Animation already configured');
    this.animationType = 'lineDrawing';
    // ...
