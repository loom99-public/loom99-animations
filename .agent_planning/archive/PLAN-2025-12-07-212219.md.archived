#### Description
Add comprehensive input validation to prevent edge cases: empty text, extremely long text, special characters, invalid path data, etc. Improve error messaging to users with specific, actionable feedback.

**Current Gaps** (from STATUS):
- No validation of text input (empty string, extremely long text)
- No validation of path data structure before sending via postMessage
- Error handling shows "❌ Error" without specific details
- No feedback if iframe doesn't receive message
- No loading state shown during font fetch

#### Acceptance Criteria
- [ ] Text input validation: Empty string rejected with user message
- [ ] Text length limit: Max 100 characters (configurable constant)
- [ ] Special character handling: Warn about unsupported characters
- [ ] Path data structure validation: Check before sending postMessage
- [ ] Error messages: Specific user-friendly descriptions (not generic "Error")
- [ ] Loading states: Show "Loading font..." during font fetch
- [ ] Timeout handling: Detect if animation iframe doesn't respond (5s timeout)
- [ ] Console logging: Detailed errors for debugging (but user-friendly UI messages)
- [ ] Validation feedback: Red border or icon on invalid input
- [ ] Success feedback: Green checkmark or "✓ Applied!" message

#### Technical Notes

**Input Validation** (index.html):
```javascript
// Add constants at top of file
const MAX_TEXT_LENGTH = 100;
const ALLOWED_CHARS_REGEX = /^[\w\s.,!?'-]+$/;

async function applyTextToAnimation(button) {
    const panel = button.closest('.animation-card').querySelector('.editor-panel');
    const textInput = panel.querySelector('.param-text');
    const text = textInput?.value || '';

    // Validate text
    if (!text || text.trim().length === 0) {
        showError(button, 'Please enter some text', textInput);
        return;
    }

    if (text.length > MAX_TEXT_LENGTH) {
        showError(button, `Text too long (max ${MAX_TEXT_LENGTH} characters)`, textInput);
        return;
    }

    // Check for unsupported characters
    if (!ALLOWED_CHARS_REGEX.test(text)) {
        showWarning(button, 'Some special characters may not render correctly');
        // Continue anyway, but warn user
    }

    // Clear any previous error states
    textInput.classList.remove('error');

    // ... proceed with generation
}

function showError(button, message, inputElement = null) {
    button.classList.add('error');
    button.textContent = `❌ ${message}`;

    if (inputElement) {
        inputElement.classList.add('error');
    }

    console.error('Validation error:', message);

    setTimeout(() => {
        button.classList.remove('error');
        button.textContent = '✨ Generate';
        if (inputElement) {
            inputElement.classList.remove('error');
        }
    }, 3000);
}

function showWarning(button, message) {
    console.warn('Validation warning:', message);
    // Could show tooltip or temporary warning icon
}
```

**Path Data Validation**:
```javascript
function validatePathData(pathData) {
    if (!Array.isArray(pathData)) {
        console.error('Path data is not an array:', typeof pathData);
        return false;
    }

    if (pathData.length === 0) {
        console.error('Path data array is empty');
        return false;
    }

    const isValid = pathData.every((item, index) => {
        const valid =
            item.d && typeof item.d === 'string' &&
            item.text && typeof item.text === 'string' &&
            item.color && typeof item.color === 'string' &&
            typeof item.y === 'number' &&
            item.bounds &&
            typeof item.bounds.x1 === 'number' &&
            typeof item.bounds.y1 === 'number' &&
            typeof item.bounds.x2 === 'number' &&
            typeof item.bounds.y2 === 'number';

        if (!valid) {
            console.error(`Invalid path data at index ${index}:`, item);
        }

        return valid;
    });

    return isValid;
}

// In applyTextToAnimation, before sending:
if (!validatePathData(pathData)) {
    showError(button, 'Failed to generate valid paths');
    return;
}
```

**Loading State**:
```javascript
async function loadFont(fontFile) {
    if (fontCache.has(fontFile)) {
        return fontCache.get(fontFile);
    }

    console.log(`Loading font: ${fontFile}...`);

    // Show loading indicator (optional - could update UI)
    // document.getElementById('loading-indicator')?.classList.add('visible');

    try {
        const font = await opentype.load(`fonts/${fontFile}.ttf`);
        fontCache.set(fontFile, font);
        console.log(`Font loaded successfully: ${fontFile}`);
        return font;
    } catch (error) {
        console.error(`Failed to load font ${fontFile}:`, error);
        throw new Error(`Font "${fontFile}" could not be loaded. Please try a different font.`);
    } finally {
        // Hide loading indicator
        // document.getElementById('loading-indicator')?.classList.remove('visible');
    }
}

// In applyTextToAnimation:
try {
    button.classList.add('generating');
    button.textContent = '⏳ Loading font...';

    const font = await loadFont(fontFile);

    button.textContent = '⏳ Generating...';

    const pathData = generateTextPathData(font, text, 'stacked');

    // ... rest of logic
} catch (error) {
    console.error('Error during text generation:', error);
    showError(button, error.message || 'Generation failed');
}
```

