class LineDrawingPresets {
  static none(overrides?: Partial<LineDrawingConfig>): LineDrawingConfig {
    return {
      timing: { duration: 1500, stagger: 50, durationVariance: 0, staggerVariance: 0 },
      colors: { hueShift: 0, satShift: 0, lightShift: 0 },
      motion: { mode: 'converge', randomStart: false },
      effects: { strokeWidth: 3, glowRadius: 0 },
      ...overrides
    };
  }

  static moderate(overrides?: Partial<LineDrawingConfig>): LineDrawingConfig {
    return {
      ...this.none(),
      timing: { ...this.none().timing, durationVariance: 0.3, staggerVariance: 0.2 },
      colors: { hueShift: Random.range(-15, 15), satShift: 0, lightShift: 0 },
      ...overrides
    };
  }

  static heavy(overrides?: Partial<LineDrawingConfig>): LineDrawingConfig {
    return {
      ...this.moderate(),
      timing: { ...this.moderate().timing, durationVariance: 0.5, staggerVariance: 0.4 },
      colors: { hueShift: Random.range(-30, 30), satShift: Random.range(-20, 20), lightShift: Random.range(-10, 10) },
      effects: { strokeWidth: Random.range(2, 5), glowRadius: Random.range(5, 15) },
      ...overrides
    };
  }
}

// Usage
const config = LineDrawingPresets.moderate({ timing: { duration: 2000 } });
```

