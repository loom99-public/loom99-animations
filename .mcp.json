{
  "mcpServers": {
    "chromedevtools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "web-search-prime": {
      "type": "stdio",
      "command": "http",
      "args": [
        "https://api.z.ai/api/mcp/web_search_prime/mcp"
      ],
      "env": {}
    },
    "web-reader": {
      "type": "stdio",
      "command": "http",
      "args": [
        "https://api.z.ai/api/mcp/web_reader/mcp"
      ],
      "env": {}
    },
    "amaccormac/gemini-mcp-tool": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "gemini-mcp-tool"
      ],
      "env": {}
    },
    "chatgpt-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "claude-chatgpt-mcp"
      ],
      "env": {}
    }
  }
}
