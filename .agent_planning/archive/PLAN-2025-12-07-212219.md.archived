**Unit Test Examples** (generateTextPathData):
```javascript
// tests/unit/text-to-paths.test.js
import { describe, test, expect, beforeAll } from 'vitest';
import * as opentype from 'opentype.js';

let font;

beforeAll(async () => {
    font = await opentype.load('fonts/Anton-Regular.ttf');
});

describe('generateTextPathData', () => {
    test('empty string returns empty array', () => {
        const result = generateTextPathData(font, '', 80);
        expect(result).toEqual([]);
    });

    test('single word generates single path', () => {
        const result = generateTextPathData(font, 'HELLO', 80);
        expect(result).toHaveLength(1);
        expect(result[0]).toHaveProperty('d');
        expect(result[0].d).toMatch(/^M/); // SVG path starts with M
        expect(result[0]).toHaveProperty('text', 'HELLO');
        expect(result[0]).toHaveProperty('color');
        expect(result[0]).toHaveProperty('y', 80);
        expect(result[0]).toHaveProperty('bounds');
    });

    test('multiple words generate multiple paths with correct Y spacing', () => {
        const result = generateTextPathData(font, 'DO IT NOW', 80);
        expect(result).toHaveLength(3);
        expect(result[0].text).toBe('DO');
        expect(result[1].text).toBe('IT');
        expect(result[2].text).toBe('NOW');

        // Y spacing should be fontSize * 1.2
        expect(result[1].y).toBe(result[0].y + 80 * 1.2);
        expect(result[2].y).toBe(result[1].y + 80 * 1.2);
    });

    test('special characters handled without errors', () => {
        expect(() => generateTextPathData(font, '!@#$%', 80)).not.toThrow();
    });

    test('bounds calculated correctly', () => {
        const result = generateTextPathData(font, 'A', 100);
        const bounds = result[0].bounds;
        expect(bounds).toHaveProperty('x1');
        expect(bounds).toHaveProperty('y1');
        expect(bounds).toHaveProperty('x2');
        expect(bounds).toHaveProperty('y2');
        expect(bounds.x2).toBeGreaterThan(bounds.x1);
        expect(bounds.y2).toBeGreaterThan(bounds.y1);
    });
});
```

**Integration Test Examples** (postMessage):
```javascript
// tests/integration/postmessage.test.js
import { describe, test, expect } from 'vitest';
import { JSDOM } from 'jsdom';

describe('postMessage communication', () => {
    test('receiver validates origin correctly', () => {
        const { window } = new JSDOM(`<!DOCTYPE html>`);
        const allowedOrigins = ['http://localhost:8888', 'http://example.com'];

        const validEvent = { origin: 'http://localhost:8888', data: { type: 'updateText' } };
        const invalidEvent = { origin: 'http://evil.com', data: { type: 'updateText' } };

        expect(allowedOrigins.includes(validEvent.origin)).toBe(true);
        expect(allowedOrigins.includes(invalidEvent.origin)).toBe(false);
    });

    test('path data structure validation', () => {
        const validPathData = [
            { d: 'M0,0 L10,10', text: 'A', color: '#fff', y: 80, bounds: { x1: 0, y1: 0, x2: 10, y2: 10 } }
        ];

        const invalidPathData = [
            { d: 'M0,0', text: 'A' } // Missing color, y, bounds
        ];

        expect(validatePathData(validPathData)).toBe(true);
        expect(validatePathData(invalidPathData)).toBe(false);
    });
});

function validatePathData(pathData) {
    if (!Array.isArray(pathData) || pathData.length === 0) return false;
    return pathData.every(item =>
        item.d && typeof item.d === 'string' &&
        item.text && typeof item.text === 'string' &&
        item.color && typeof item.color === 'string' &&
        typeof item.y === 'number' &&
        item.bounds && item.bounds.x1 !== undefined
    );
}
```

**E2E Test Examples** (Playwright):
```javascript
// tests/e2e/gallery.spec.js
import { test, expect } from '@playwright/test';

test.describe('Dynamic Text Feature', () => {
    test('user can generate custom text in SVG path animation', async ({ page }) => {
        await page.goto('http://localhost:8888/index.html');

        // Find universal-paths animation card
        const card = page.locator('.animation-card').filter({ hasText: 'Universal Paths' });
        await expect(card).toBeVisible();

        // Enter custom text
        await card.locator('.param-text').fill('HELLO');

        // Select font
        await card.locator('.param-font').selectOption('Anton-Regular');

        // Click generate
        await card.locator('.editor-btn-apply').click();

        // Wait for animation to update
        await page.waitForTimeout(500);

        // Verify iframe has SVG path elements
        const iframe = card.frameLocator('iframe');
        const paths = iframe.locator('svg path.text-path');

        await expect(paths).toHaveCount(1); // "HELLO" is one word
    });

    test('user can generate multi-word text in particle animation', async ({ page }) => {
        await page.goto('http://localhost:8888/index.html');

        const card = page.locator('.animation-card').filter({ hasText: 'Particles' }).first();

        await card.locator('.param-text').fill('GO NOW');
        await card.locator('.param-font').selectOption('Roboto-Bold');
        await card.locator('.editor-btn-apply').click();

        await page.waitForTimeout(1000);

        // Verify canvas exists and is not empty
        const iframe = card.frameLocator('iframe');
        const canvas = iframe.locator('canvas');
        await expect(canvas).toBeVisible();
    });

    test('multiple generations update animation correctly', async ({ page }) => {
        await page.goto('http://localhost:8888/index.html');

        const card = page.locator('.animation-card').filter({ hasText: 'Universal Paths' });

        // First generation
        await card.locator('.param-text').fill('FIRST');
        await card.locator('.editor-btn-apply').click();
        await page.waitForTimeout(500);

        // Second generation (should replace first)
        await card.locator('.param-text').fill('SECOND');
        await card.locator('.editor-btn-apply').click();
        await page.waitForTimeout(500);

        // Verify updated (implementation-specific check)
        const iframe = card.frameLocator('iframe');
        const paths = iframe.locator('svg path.text-path');
        await expect(paths).toHaveCount(1); // Still one word
    });
});
```

